#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

if [[ -f .env ]]; then
  set -a
  source .env
  set +a
fi

docker compose up -d db

bundle check || bundle install

bundle exec rails db:create db:migrate

if [[ ! -f config/initializers/themes/default.rb ]]; then
  bundle exec rails g spina:install --silent
else
  echo "Spina already installed, skipping generator"
fi

bundle exec rails spina:setup_admin
bundle exec rails spina:sync_site
bundle exec rails spina:tailwind:build

cat <<'EOF'
Spina setup complete.
Start the app with:
  bundle exec rails server

Spina admin:
  http://localhost:3000/admin
EOF
