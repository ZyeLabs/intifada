{#
  → WordPress: footer.php

  `footerNav` is NOT `nav` — it has a fifth item (Islamic Relief). Separate menu
  location ("footer").
#}
<footer class="site-footer">
  <div class="site-footer__main" data-animate="fade-up">
    <div class="site-footer__brand">
      <a href="{{ root }}index.html" class="site-footer__brand-link" aria-label="{{ site.name }}">
        <img alt="" width="800" height="380" class="site-footer__brand-image" src="{{ root }}{{ site.logoDark }}" />
      </a>
    </div>

    <div class="site-footer__divider" aria-hidden="true"></div>

    <div class="site-footer__mission-wrap">
      <p class="site-footer__mission">{{ site.footerMission }}</p>
    </div>
  </div>

  <div class="site-footer__bottom" data-animate="fade-up" data-animate-delay="0.08">
    <div class="site-footer__bottom-group site-footer__bottom-group--links">
      <nav class="site-footer__links" aria-label="Footer">
        {%- for item in footerNav %}
        <a class="site-footer__link"
           href="{% if item.external %}{{ item.url }}{% else %}{{ root }}{{ item.url }}{% endif %}"
           {%- if item.external %} target="_blank" rel="noopener"{% endif %}>{{ item.label }}</a>
        {%- endfor %}
      </nav>
    </div>

    <div class="site-footer__bottom-group">
      <div class="site-footer__social">
        {%- for item in social %}
        <a class="site-footer__social-link" target="_blank" rel="noopener" aria-label="{{ item.label }}" href="{{ item.url }}"><span class="site-footer__social-text">{{ item.label }}</span></a>
        {%- endfor %}
      </div>
    </div>
  </div>
</footer>
