<main class="page page--news-index">
  <% news = news_index_presenter %>
  <% active_filter = news.active_filter %>
  <% filter_options = news.filter_options %>
  <% lead_story = news.lead_story %>
  <% rail_stories = news.rail_stories %>
  <% archive_stories = news.history_page_stories %>
  <% archive_groups = archive_stories.group_by do |story|
       publish_at = article_publish_datetime(story) || story.created_at
       publish_at&.in_time_zone&.beginning_of_month || Time.zone.now.beginning_of_month
     end %>

  <% if filter_options.present? %>
    <nav class="news-filter-bar" aria-label="Filter news by tag">
      <div class="news-filter-bar__inner">
        <p class="news-filter-bar__label">Topics</p>
        <div class="news-filter-bar__chips">
          <%= link_to "All", news.filter_path, class: ["news-filter-bar__link", ("is-active" unless active_filter.present?)].compact.join(" "), "aria-current": (active_filter.blank? ? "page" : nil) %>
          <% filter_options.each do |filter| %>
            <%= link_to filter[:label], news.filter_path(filter[:slug]), class: ["news-filter-bar__link", ("is-active" if active_filter == filter)].compact.join(" "), "aria-current": (active_filter == filter ? "page" : nil) %>
          <% end %>
        </div>
      </div>
    </nav>
  <% end %>

  <% if lead_story.present? %>
    <% lead_story_kicker = article_badge_label(lead_story, fallback: "News") %>
    <% lead_story_summary = article_summary(lead_story) %>
    <% lead_story_author = article_author_name(lead_story) %>
    <section class="news-feature" aria-label="Lead story and related articles">
      <article class="news-feature__main">
        <div class="news-feature__image-frame">
          <a href="<%= cms_page_path(lead_story) %>" class="news-feature__image-link" aria-label="<%= lead_story.title %>" data-animate="clip-reveal">
            <%= image_tag page_image_url(lead_story, part_name: :hero_image, resize_to_fill: [1620, 912], fallback: "events/upcoming-default.jpg"), alt: lead_story.title, class: "news-feature__image", loading: "eager", decoding: "async" %>
          </a>
          <span class="news-feature__badge" data-animate="scale-in" data-animate-delay="0.12"><%= lead_story_kicker.upcase %></span>
        </div>

        <div class="news-feature__content">
          <h2 class="news-feature__title">
            <%= link_to lead_story.title, cms_page_path(lead_story), class: "news-feature__title-link", data: { animate: "word-stagger", animate_delay: "0.08" } %>
          </h2>

          <% if lead_story_summary.present? %>
            <p class="news-feature__summary" data-animate="fade-up" data-animate-delay="0.18"><%= truncate(lead_story_summary, length: 180) %></p>
          <% end %>

          <p class="news-feature__meta" data-animate="fade-up" data-animate-delay="0.26">
            <span class="news-feature__author">By <%= lead_story_author %></span>
            <span class="news-feature__dot" aria-hidden="true">•</span>
            <time datetime="<%= article_publish_datetime(lead_story)&.iso8601 %>"><%= article_publish_long_label(lead_story) %></time>
          </p>
        </div>
      </article>

      <aside class="news-related" aria-label="Related articles">
        <h2 class="news-related__heading" data-animate="fade-left">Related articles</h2>

        <% if rail_stories.present? %>
          <div class="news-related__list" data-animate-group="stagger" data-animate-delay="0.08">
            <% rail_stories.each do |story| %>
              <% rail_kicker = article_badge_label(story, fallback: "News") %>
              <% rail_summary = article_summary(story) %>
              <article class="news-related__item">
                <a href="<%= cms_page_path(story) %>" class="news-related__media-link" aria-label="<%= story.title %>">
                  <%= image_tag page_image_url(story, part_name: :hero_image, resize_to_fill: [720, 540], fallback: "events/upcoming-default.jpg"), alt: story.title, class: "news-related__media", loading: "lazy", decoding: "async" %>
                </a>
                <div class="news-related__content">
                  <p class="news-related__tag"><%= rail_kicker.upcase %></p>
                  <h3 class="news-related__title">
                    <%= link_to story.title, cms_page_path(story), class: "news-related__title-link" %>
                  </h3>
                  <% if rail_summary.present? %>
                    <p class="news-related__summary"><%= truncate(rail_summary, length: 84) %></p>
                  <% end %>
                </div>
              </article>
            <% end %>
          </div>
        <% else %>
          <p class="news-related__empty">More stories will appear here as new reporting is published.</p>
        <% end %>
      </aside>
    </section>
  <% else %>
    <section class="news-empty" aria-label="Newsroom empty state">
      <h2 class="news-empty__title">
        <% if active_filter.present? %>
          Nothing published yet for <%= active_filter[:label] %>
        <% else %>
          Nothing published yet
        <% end %>
      </h2>
      <p class="news-empty__text">
        <% if active_filter.present? %>
          Clear the filter to browse everything in the newsroom.
        <% else %>
          Publish the first story to populate the catalogue.
        <% end %>
      </p>
      <% if active_filter.present? %>
        <%= link_to "View all news", news.filter_path, class: "news-empty__reset" %>
      <% end %>
    </section>
  <% end %>

  <% if archive_stories.present? %>
    <section class="news-calendar" id="news-archive" aria-label="News archive">
      <header class="news-calendar__header" data-animate="fade-up">
        <h2 class="news-calendar__title"><%= news.archive_heading %></h2>
      </header>

      <div class="news-calendar__months">
        <% archive_groups.sort_by { |month, _stories| month }.reverse_each do |month, stories| %>
          <section class="news-calendar-month" aria-label="<%= month.strftime('%B %Y') %>" data-animate="fade-up">
            <div class="news-calendar-month__label">
              <p class="news-calendar-month__month"><%= month.strftime("%B %Y") %></p>
            </div>

            <div class="news-calendar-month__cards" data-animate-group="stagger" data-animate-delay="0.08">
              <% stories.sort_by { |story| article_publish_datetime(story) || story.created_at }.reverse_each do |story| %>
                <% archive_publish_at = article_publish_datetime(story) || story.created_at %>
                <article class="news-archive-card">
                  <a href="<%= cms_page_path(story) %>" class="news-archive-card__image-link" aria-label="<%= story.title %>">
                    <%= image_tag page_image_url(story, part_name: :hero_image, resize_to_fill: [720, 540], fallback: "events/upcoming-default.jpg"), alt: story.title, class: "news-archive-card__image", loading: "lazy", decoding: "async" %>
                  </a>

                  <div class="news-archive-card__content">
                    <h3 class="news-archive-card__title">
                      <%= link_to story.title, cms_page_path(story), class: "news-archive-card__title-link" %>
                    </h3>
                    <time class="news-archive-card__date" datetime="<%= archive_publish_at&.iso8601 %>"><%= archive_publish_at&.strftime("%B %d, %Y") || article_publish_long_label(story) %></time>
                  </div>
                </article>
              <% end %>
            </div>
          </section>
        <% end %>
      </div>

      <% if news.total_pages > 1 %>
        <nav class="news-calendar__pagination" aria-label="Archive pages">
          <div class="news-calendar__pagination-desktop">
            <% if news.previous_page.present? %>
              <%= link_to "Previous", news.page_path(news.previous_page), class: "news-calendar__page news-calendar__page--nav" %>
            <% end %>

            <% news.pagination_pages.each do |page_number| %>
              <%= link_to page_number, news.page_path(page_number), class: ["news-calendar__page", ("is-active" if news.current_page == page_number)].compact.join(" "), "aria-current": (news.current_page == page_number ? "page" : nil) %>
            <% end %>

            <% if news.next_page.present? %>
              <%= link_to "Next", news.page_path(news.next_page), class: "news-calendar__page news-calendar__page--nav" %>
            <% end %>
          </div>

          <div class="news-calendar__pagination-mobile">
            <% if news.previous_page.present? %>
              <%= link_to "Previous", news.page_path(news.previous_page), class: "news-calendar__page news-calendar__page--nav" %>
            <% else %>
              <span class="news-calendar__page news-calendar__page--disabled">Previous</span>
            <% end %>

            <span class="news-calendar__page-label">Page <%= news.current_page %> of <%= news.total_pages %></span>

            <% if news.next_page.present? %>
              <%= link_to "Next", news.page_path(news.next_page), class: "news-calendar__page news-calendar__page--nav" %>
            <% else %>
              <span class="news-calendar__page news-calendar__page--disabled">Next</span>
            <% end %>
          </div>
        </nav>
      <% end %>
    </section>
  <% end %>
</main>
