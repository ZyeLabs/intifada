<% event_status = event_status_label(current_page, fallback: "Upcoming") %>
<% cta_label = content(:registration_label).presence || "Register now" %>
<% cta_url = safe_url(content(:registration_url), default: "#") %>
<% cta_external = cta_url.start_with?("http") %>
<% show_registration_cta = cta_url != "#" %>
<% hero = page_image_url(current_page, part_name: :hero_image, resize_to_fill: [1400, 760], fallback: "events/past-spotlight.png") %>

<main class="page page--event-detail">
  <article class="event-template" data-mobile-sticky-context>
    <header class="event-template__header">
      <h1 data-animate="word-stagger"><%= current_page.title %></h1>
      <% if content(:summary).present? %>
        <p class="event-template__summary" data-animate="fade-up" data-animate-delay="0.12"><%= content(:summary) %></p>
      <% end %>

      <ul class="event-template__meta" data-animate="fade-up" data-animate-delay="0.2">
        <li><span>Date</span><strong><%= content(:event_date).presence || "TBC" %></strong></li>
        <li><span>Time</span><strong><%= content(:event_time).presence || "TBC" %></strong></li>
        <li><span>Location</span><strong><%= content(:event_location).presence || "TBC" %></strong></li>
      </ul>
    </header>

    <figure class="event-template__hero" data-mobile-sticky-target data-animate="clip-reveal" data-parallax="soft">
      <%= image_tag hero, alt: current_page.title, decoding: "async" %>
    </figure>

    <div class="event-template__content-grid">
      <aside class="event-template__aside" data-animate-group="stagger">
        <h3>Key information</h3>
        <dl>
          <div>
            <dt>Status</dt>
            <dd><%= event_status %></dd>
          </div>
          <div>
            <dt>Registration</dt>
            <dd><%= content(:registration_label).presence || "Open" %></dd>
          </div>
          <div>
            <dt>Location</dt>
            <dd><%= content(:event_location).presence || "TBC" %></dd>
          </div>
          <div>
            <dt>Time</dt>
            <dd><%= content(:event_time).presence || "TBC" %></dd>
          </div>
        </dl>

        <% if show_registration_cta %>
          <%= link_to cta_label, cta_url, class: "event-template__cta", target: (cta_external ? "_blank" : nil), rel: (cta_external ? "noopener" : nil) %>
        <% end %>
        <p class="event-template__aside-note">Secure your place before event day.</p>
      </aside>

      <section class="event-template__about">
        <header>
          <h2>About the event</h2>
        </header>
        <div class="event-template__body">
          <% if content(:body).present? %>
            <%= content.html :body %>
          <% else %>
            <p>Event details will be published soon.</p>
          <% end %>
        </div>
      </section>
    </div>

    <% if show_registration_cta %>
      <div class="event-template__sticky-cta" data-mobile-sticky-cta hidden>
        <div class="event-template__sticky-copy">
          <span class="event-template__sticky-label">Event registration</span>
          <strong><%= cta_label %></strong>
        </div>
        <%= link_to cta_label, cta_url, class: "event-template__sticky-button", target: (cta_external ? "_blank" : nil), rel: (cta_external ? "noopener" : nil) %>
      </div>
    <% end %>
  </article>

  <% related = events_query.related_upcoming_for(current_page, limit: 3) %>
  <% if related.present? %>
    <section class="events-catalogue__section">
      <header class="events-catalogue__heading" data-animate="fade-up">
        <h2>More upcoming events</h2>
        <span aria-hidden="true"></span>
      </header>
      <div class="events-catalogue__grid" data-animate-group="stagger" data-animate-delay="0.08">
        <% related.each do |event| %>
          <%= render EventCardComponent.new(page: event) %>
        <% end %>
      </div>
    </section>
  <% end %>
</main>
