<main class="page page--article">
  <% author_name = article_author_name(current_page) %>
  <% badge_label = article_badge_label(current_page, fallback: "News") %>
  <% standfirst = article_summary(current_page) %>
  <% hero = page_image_url(current_page, part_name: :hero_image, resize_to_fill: [1800, 1080]) %>
  <% share_url = request&.original_url.presence || cms_page_path(current_page) %>
  <% manual_related = [content(:related_story_1), content(:related_story_2), content(:related_story_3)].compact.reject { |story| story == current_page } %>
  <% query_related = Array(articles_query.related_for(current_page, limit: 6)) %>
  <% related = (manual_related + query_related).uniq { |story| story&.id || story.object_id }.first(3) %>

  <article class="article-detail">
    <header class="article-detail__header">
      <%= link_to "Back to news", resource_index_path("articles"), class: "article-detail__back", data: { animate: "fade-up" } %>

      <% if badge_label.present? %>
        <p class="article-detail__kicker" data-animate="fade-up" data-animate-delay="0.08"><%= badge_label %></p>
      <% end %>

      <h1 data-animate="word-stagger" data-animate-delay="0.12"><%= current_page.title %></h1>

      <% if standfirst.present? %>
        <p class="article-detail__standfirst" data-animate="fade-up" data-animate-delay="0.2"><%= standfirst %></p>
      <% end %>

      <p class="article-detail__meta" data-animate="fade-up" data-animate-delay="0.28">
        <span>By <%= author_name %></span>
        <span aria-hidden="true">•</span>
        <time datetime="<%= article_publish_datetime(current_page)&.iso8601 %>"><%= article_publish_long_label(current_page) %></time>
      </p>
    </header>

    <div class="article-detail__content-grid">
      <div class="article-detail__primary">
        <% if hero.present? %>
          <figure class="article-detail__hero" data-animate="clip-reveal">
            <%= image_tag hero, alt: current_page.title, decoding: "async" %>
          </figure>
        <% end %>

        <div class="article-detail__body" data-progress-target="article">
          <% if content(:body).present? %>
            <%= content.html :body %>
          <% else %>
            <p>Story content will be published soon.</p>
          <% end %>
        </div>
      </div>

      <aside class="article-detail__aside" aria-label="Story actions and facts" data-animate-group="stagger" data-animate-delay="0.08">
        <div class="article-detail__aside-card">
          <p class="article-detail__aside-label">Share this story</p>
          <div class="article-share" data-share-url="<%= share_url %>" data-share-title="<%= current_page.title %>">
            <div class="article-share__actions">
              <button type="button" class="article-share__button" data-share-action="native">Share story</button>
              <button type="button" class="article-share__button article-share__button--secondary" data-share-action="copy">Copy link</button>
            </div>
            <p class="article-share__status" data-share-status aria-live="polite"></p>
          </div>
        </div>

        <div class="article-detail__aside-card">
          <p class="article-detail__aside-label">Story facts</p>
          <dl class="article-facts">
            <% if badge_label.present? %>
              <div class="article-facts__row">
                <dt>Section</dt>
                <dd><%= badge_label %></dd>
              </div>
            <% end %>
            <div class="article-facts__row">
              <dt>Published</dt>
              <dd><%= article_publish_long_label(current_page) %></dd>
            </div>
          </dl>
        </div>
      </aside>
    </div>
  </article>

  <section class="article-followup" aria-label="Continue reading">
    <header class="article-followup__header" data-animate="fade-up">
      <div>
        <p class="article-followup__eyebrow">Continue reading</p>
        <h2>More from the newsroom</h2>
      </div>
      <%= link_to "Back to news", resource_index_path("articles"), class: "article-followup__back" %>
    </header>

    <% if related.present? %>
      <div class="news-grid article-followup__grid" data-animate-group="stagger" data-animate-delay="0.08">
        <% related.each do |story| %>
          <%= render StoryCardComponent.new(page: story) %>
        <% end %>
      </div>
    <% end %>
  </section>
</main>
