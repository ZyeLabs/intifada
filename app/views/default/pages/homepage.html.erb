<main class="homepage">
  <% homepage = homepage_presenter %>
  <% lead_story = homepage.lead_story_card %>
  <% latest = homepage.latest_story_cards(limit: 4) %>
  <% campaigns = homepage.campaign_cards(limit: 3) %>
  <% upcoming = homepage.event_cards(limit: 3) %>
  <% action_sections = [
    {title: "Active campaigns", accent: "green", path: resource_index_path("campaigns"), items: campaigns, delay: "0.08"},
    {title: "Upcoming events", accent: "black", path: resource_index_path("events"), items: upcoming, delay: "0.12"}
  ].select { |section| section[:items].present? } %>

  <% if homepage.breaking_story.present? %>
    <section class="breaking-strip home-band" aria-label="Breaking update">
      <div class="home-shell">
        <p class="breaking-strip__content" data-animate="fade-up" data-animate-origin="top">
          <span class="breaking-strip__label" data-animate="scale-in" data-animate-delay="0.14">Breaking</span>
          <%= link_to homepage.breaking_story.title, cms_page_path(homepage.breaking_story), class: "breaking-strip__link" %>
        </p>
      </div>
    </section>
  <% end %>

  <% if lead_story.present? || latest.present? %>
    <div class="page page--homepage">
      <section class="home-hero <%= "home-hero--lead-only" if latest.blank? %>" aria-label="Lead story and latest news">
        <% if lead_story.present? %>
          <div class="home-hero__lead">
            <article class="lead-story">
              <div class="lead-story__media-wrap">
                <%= link_to image_tag(lead_story[:image_url], alt: lead_story[:title], class: "lead-story__image", decoding: "async"), lead_story[:url], class: "lead-story__image-link", data: { animate: "clip-reveal" } %>
                <span class="lead-story__badge" data-animate="scale-in" data-animate-delay="0.12"><%= lead_story[:kicker].upcase %></span>
              </div>

              <h1 class="lead-story__title">
                <%= link_to lead_story[:title], lead_story[:url], class: "lead-story__title-link", data: { animate: "word-stagger", animate_delay: "0.08" } %>
              </h1>
              <% if lead_story[:standfirst].present? %>
                <p class="lead-story__standfirst" data-animate="fade-up" data-animate-delay="0.2"><%= lead_story[:standfirst] %></p>
              <% end %>
              <p class="lead-story__meta" data-animate="fade-up" data-animate-delay="0.28">
                <span class="lead-story__author">BY <%= lead_story[:author_name] %></span>
              </p>
            </article>
          </div>
        <% end %>

        <% if latest.present? %>
          <aside class="home-hero__latest" aria-label="Latest news">
            <header class="home-latest__header" data-animate="fade-left" data-animate-delay="0.18">
              <h2>Latest news</h2>
              <%= link_to "View all", resource_index_path("articles"), class: "home-latest__header-link" %>
            </header>

            <div class="home-latest__list" data-animate-group="stagger" data-animate-delay="0.24">
              <% latest.each do |story| %>
                <article class="home-latest__item">
                  <p class="home-latest__kicker"><%= story[:kicker].upcase %></p>
                  <h3 class="home-latest__title">
                    <%= link_to story[:title], story[:url], class: "home-latest__title-link" %>
                  </h3>
                  <% if story[:standfirst].present? %>
                    <p class="home-latest__snippet"><%= truncate(story[:standfirst], length: 80) %></p>
                  <% end %>
                  <p class="home-latest__time"><%= story[:age_label] %></p>
                </article>
              <% end %>
            </div>

            <%= link_to "View all news", resource_index_path("articles"), class: "home-latest__button" %>
          </aside>
        <% end %>
      </section>
    </div>
  <% end %>

  <section class="home-mission home-band" aria-label="Our mission">
    <div class="home-shell">
      <div class="home-mission__inner">
        <% mission_text = homepage.mission_text %>
        <% if mission_text.present? %>
          <h2 class="home-mission__heading" data-animate="fade-up">Our mission</h2>
          <p class="home-mission__copy" data-animate="fade-up" data-animate-delay="0.12"><%= mission_text %></p>
          <span class="home-mission__accent" aria-hidden="true" data-animate="line-grow" data-animate-delay="0.28"></span>
        <% end %>
      </div>
    </div>
  </section>

  <% if action_sections.any? %>
    <div class="page page--homepage page--homepage-secondary">
      <section class="home-action-grid" aria-label="Campaigns and events">
        <div class="home-action-grid__inner">
          <% action_sections.each do |section| %>
            <div class="home-action-section home-action-section--<%= section[:accent] %>">
              <header class="home-section-title home-section-title--<%= section[:accent] %>" data-animate="fade-up">
                <h2><%= section[:title] %></h2>
                <%= link_to "See all", section[:path], class: "home-section-title__link" %>
              </header>

              <div class="home-action-list" data-animate-group="stagger" data-animate-delay="<%= section[:delay] %>">
                <% section[:items].each do |item| %>
                  <% link_target = item[:external] ? "_blank" : nil %>
                  <% link_rel = item[:external] ? "noopener" : nil %>

                  <article class="home-action-card home-action-card--<%= section[:accent] %>">
                    <% if item[:meta_label].present? %>
                      <div class="home-action-card__meta">
                        <p class="home-action-card__meta-text"><%= item[:meta_label] %></p>
                      </div>
                    <% end %>

                    <h3 class="home-action-card__title">
                      <%= link_to item[:title], item[:url], class: "home-action-card__title-link", target: link_target, rel: link_rel %>
                    </h3>

                    <% if item[:details].present? %>
                      <p class="home-action-card__details"><%= item[:details] %></p>
                    <% end %>

                    <div class="home-action-card__footer">
                      <%= link_to item[:cta_label], item[:url], class: "home-action-card__link", target: link_target, rel: link_rel %>
                    </div>
                  </article>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </section>
    </div>
  <% end %>

  <section class="home-cta home-band" aria-label="Support and contact">
    <div class="home-shell home-cta__inner">
      <div class="home-cta__copy" data-animate-group="stagger">
        <h2>Support our mission</h2>
        <p>Join us in advancing digital activism and amplifying voices.</p>
      </div>

      <div class="home-cta__actions" data-animate-group="stagger" data-animate-delay="0.12">
        <% donate_url = donate_page_path || "/donate" %>
        <% contact_url = footer_contact_email.present? ? "mailto:#{footer_contact_email}" : "/about-us" %>
        <%= link_to "Donate now", donate_url, class: "home-cta__primary" %>
        <%= link_to "Get in touch", contact_url, class: "home-cta__secondary" %>
      </div>
    </div>
  </section>
</main>
