<% approach_items = [
  {
    icon: "voice",
    title: "Awareness & Education",
    body: "Empower communities with knowledge and amplify voices that are often silenced by mainstream narratives."
  },
  {
    icon: "expose",
    title: "Exposing Oppression",
    body: "Challenge false narratives and document injustices with rigorous accuracy to demand global accountability."
  },
  {
    icon: "aid",
    title: "Immediate Aid",
    body: "Direct support on the ground through strategic aid projects to alleviate suffering and sustain resilience."
  }
] %>

<% principles = [
  {
    title: "Unapologetic Activism",
    body: "Speak truth to power without compromise in the face of injustice."
  },
  {
    title: "Islamic Values",
    body: "Our compass is guided by the eternal wisdom of the Qur'an and Sunnah."
  },
  {
    title: "Resistance Until Liberation",
    body: "Fully committed to achieving justice and liberation for the oppressed."
  },
  {
    title: "For the Pleasure of Allah",
    body: "Sincere actions; we strive for the sake of Allah, knowing outcomes are from Him."
  }
] %>

<% hero_title = "A Voice for Justice." %>
<% hero_kicker = "Manifesto" %>
<% hero_quote = "Cooperate with one another in goodness and righteousness, and do not cooperate in sin and transgression. And be mindful of Allah. Surely Allah is severe in punishment." %>
<% hero_quote_source = "Al Ma'idah 5:2" %>
<% hero_badge = "Founded Nov 2023" %>
<% hero_image_url = "/bgabout.jpg" %>
<% mission_heading = "The mission" %>
<% mission_title = "Front-Foot Activism" %>
<% mission_body = "Committed to unapologetic, front-foot digital activism grounded in the principles of the Qur'an and Sunnah. We aim to raise awareness, educate, and empower individuals to stand in solidarity with Palestine and Bilad Ash Shaam." %>
<% mission_quote = "Whosoever of you sees an evil, let him change it with his hand; and if he is not able to do so, then [let him change it] with his tongue; and if he is not able to do so, then with his heart — and that is the weakest of faith." %>
<% mission_quote_source = "Sahih Muslim" %>
<% purpose_heading = "The purpose" %>
<% purpose_title = "Inspiring communities to take action with knowledge, courage, and conviction." %>
<% purpose_body = "Social Intifada exists to be a loud, authoritative voice for justice and liberation in an age of digital transformation." %>
<% cta_heading = "Journalism is our weapon. Truth is our ammunition." %>
<% cta_kicker = "-" %>
<% cta_primary_label = "Donate" %>
<% cta_primary_url = donate_page_path || "/donate" %>
<% cta_secondary_label = "Contact us" %>
<% default_contact_url = footer_contact_email.present? ? "mailto:#{footer_contact_email}" : "#" %>
<% cta_secondary_url = default_contact_url %>

<main class="page page--about">
  <section class="about-hero">
    <div class="about-shell">
      <div class="about-hero__inner">
        <div class="about-hero__copy">
          <p class="about-hero__kicker" data-animate="fade-up"><%= hero_kicker %></p>
          <h1 data-animate="word-stagger" data-animate-delay="0.08"><%= hero_title %></h1>
          <p class="about-hero__badge" data-animate="scale-in" data-animate-delay="0.18"><%= hero_badge %></p>
        </div>

        <aside class="about-hero__quote about-hero__quote--desktop" data-animate="fade-left" data-animate-delay="0.18">
          <blockquote>
            <p><%= hero_quote %></p>
          </blockquote>
          <p class="about-hero__quote-source"><%= hero_quote_source %></p>
        </aside>
      </div>
    </div>
  </section>

  <% if hero_image_url.present? %>
    <section class="about-image-break" aria-label="About feature image" data-animate="clip-reveal" data-parallax="soft">
      <img src="<%= hero_image_url %>" alt="<%= hero_title %>" loading="lazy" decoding="async">
    </section>
  <% end %>

  <section class="about-hero-quote about-hero-quote--mobile" aria-label="Manifesto quote">
    <div class="about-shell">
      <aside class="about-hero__quote" data-animate="fade-up">
        <blockquote>
          <p><%= hero_quote %></p>
        </blockquote>
        <p class="about-hero__quote-source"><%= hero_quote_source %></p>
      </aside>
    </div>
  </section>

  <section class="about-approach">
    <div class="about-shell">
      <header class="about-section-heading about-section-heading--center" data-animate="fade-up">
        <h2>Our approach</h2>
        <p>Operating through digital content, in-depth reports, events, and public engagements to spark meaningful change.</p>
      </header>

      <div class="about-approach__grid" data-animate-group="stagger" data-animate-delay="0.08">
        <% approach_items.each do |item| %>
          <article class="about-approach-card">
            <span class="about-approach-card__icon" data-animate="draw-in" data-svg-draw><%= about_icon_svg(item[:icon]) %></span>
            <h3><%= item[:title] %></h3>
            <p><%= item[:body] %></p>
          </article>
        <% end %>
      </div>
    </div>
  </section>

  <section class="about-mission">
    <div class="about-shell about-mission__grid">
      <article class="about-mission__story">
        <p class="about-label" data-animate="fade-up"><%= mission_heading %></p>
        <h2 data-animate="fade-up" data-animate-delay="0.08"><%= mission_title %></h2>
        <p class="about-mission__body" data-animate="fade-up" data-animate-delay="0.14"><%= mission_body %></p>

        <div class="about-quote-card" data-animate="fade-right" data-animate-delay="0.22">
          <blockquote>
            <p><%= mission_quote %></p>
          </blockquote>
          <p class="about-quote-card__source"><%= mission_quote_source %></p>
        </div>
      </article>

      <aside class="about-principles" data-animate="fade-left" data-animate-delay="0.12">
        <p class="about-label about-label--inverse">Core principles</p>

        <div class="about-principles__list">
          <% principles.each do |principle| %>
            <details class="about-principle" data-mobile-collapse open>
              <summary class="about-principle__summary">
                <h3><%= principle[:title] %></h3>
                <span class="about-principle__toggle" aria-hidden="true"></span>
              </summary>
              <div class="about-principle__body">
                <p><%= principle[:body] %></p>
              </div>
            </details>
          <% end %>
        </div>
      </aside>
    </div>
  </section>

  <section class="about-purpose">
    <div class="about-shell about-purpose__inner" data-animate-group="stagger">
      <p class="about-label"><%= purpose_heading %></p>
      <h2><%= purpose_title %></h2>
      <p><%= purpose_body %></p>
    </div>
  </section>

  <section class="about-cta-band">
    <div class="about-shell about-cta-band__inner">
      <div class="about-cta-band__copy" data-animate-group="stagger">
        <h2><%= cta_heading %></h2>
        <p><%= cta_kicker %></p>
      </div>

      <div class="about-cta-band__actions" data-animate-group="stagger" data-animate-delay="0.12">
        <%= link_to cta_primary_label, cta_primary_url, class: "button button--donate about-cta-band__button", target: (cta_primary_url.start_with?("http") ? "_blank" : nil), rel: (cta_primary_url.start_with?("http") ? "noopener" : nil) %>
        <%= link_to cta_secondary_label, cta_secondary_url, class: "button about-cta-band__button about-cta-band__button--secondary", target: (cta_secondary_url.start_with?("http") ? "_blank" : nil), rel: (cta_secondary_url.start_with?("http") ? "noopener" : nil) %>
      </div>
    </div>
  </section>
</main>
