<div class="mt-6">
  <label class="block text-sm leading-5 font-medium text-gray-700"><%= f.object.title %></label>
  <div class="text-gray-400 text-sm"><%= f.object.hint %></div>
  <div class="mt-1">
    <% input_name = f.object.name.to_s %>
    <% input_options = {class: "form-input block w-full max-w-5xl sm:text-sm sm:leading-5"} %>
    <% if input_name.end_with?("_date") || input_name.include?("deadline") %>
      <%= f.text_field :content, input_options.merge(type: "date") %>
    <% elsif input_name.end_with?("_time") %>
      <%= f.text_field :content, input_options.merge(type: "time", step: 60) %>
    <% else %>
      <%= f.text_field :content, input_options %>
    <% end %>
  </div>
</div>
