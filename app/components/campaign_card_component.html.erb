<% image_url = helpers.page_image_url(page, part_name: :hero_image, resize_to_fill: [960, 720], fallback: "events/past-default.png") %>
<% status = helpers.campaign_status_label(page, fallback: (past ? "Completed" : "Active")) %>
<% deadline_label = helpers.campaign_deadline_label(page) %>
<% summary = helpers.page_part_text(page, :summary, helpers.page_body_excerpt(page, fallback: "Campaign update coming soon.", limit: 132)) %>
<% label = helpers.page_part_text(page, :campaign_cta_label, (past ? "View campaign" : "Take action")) %>
<% url = helpers.safe_url(helpers.page_part_text(page, :campaign_cta_url), default: helpers.cms_page_path(page)) %>
<% external = url.start_with?("http") %>
<% supporting = status %>

<article class="catalogue-card <%= "catalogue-card--past" if past %>">
  <a href="<%= helpers.cms_page_path(page) %>" class="catalogue-card__media-link" aria-label="<%= page.title %>">
    <%= image_tag image_url, alt: page.title, class: "catalogue-card__media", loading: "lazy", decoding: "async" %>
  </a>

  <div class="catalogue-card__body">
    <% if show_top_meta %>
      <% stamp_value = deadline_label.present? ? helpers.campaign_deadline_day_number(page) : (past ? "DONE" : "LIVE") %>
      <% stamp_label = deadline_label.present? ? helpers.campaign_deadline_month_short(page) : "CAMPAIGN" %>
      <% detail = deadline_label.present? ? "Deadline #{deadline_label}" : status %>
      <div class="catalogue-card__top">
        <div class="catalogue-card__stamp <%= "catalogue-card__stamp--text" if past %>">
          <span class="catalogue-card__stamp-value"><%= stamp_value %></span>
          <span class="catalogue-card__stamp-label"><%= stamp_label %></span>
        </div>

        <div class="catalogue-card__meta-block">
          <p class="catalogue-card__eyebrow"><%= past ? "Completed campaign" : "Active campaign" %></p>
          <p class="catalogue-card__detail"><%= detail %></p>
        </div>
      </div>
    <% end %>

    <h3 class="catalogue-card__title">
      <%= link_to page.title, helpers.cms_page_path(page), class: "catalogue-card__title-link" %>
    </h3>

    <p class="catalogue-card__summary"><%= summary %></p>

    <div class="catalogue-card__footer">
      <% if show_supporting %>
        <p class="catalogue-card__supporting"><%= supporting %></p>
      <% end %>
      <%= link_to label, url, class: "catalogue-card__button", target: (external ? "_blank" : nil), rel: (external ? "noopener" : nil) %>
    </div>
  </div>
</article>
