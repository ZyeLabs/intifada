<% image_url = helpers.page_image_url(page, part_name: :hero_image, resize_to_fill: [960, 720], fallback: "events/upcoming-default.jpg") %>
<% summary = helpers.page_part_text(page, :summary, helpers.page_body_excerpt(page, fallback: "Event details will be published soon.", limit: 132)) %>
<% location = helpers.page_part_text(page, :event_location, (past ? "Event archive" : "Venue to be confirmed")) %>
<% label = helpers.page_part_text(page, :registration_label, (past ? "View event" : "View details")) %>
<% url = helpers.safe_url(helpers.page_part_text(page, :registration_url), default: helpers.cms_page_path(page)) %>
<% external = url.start_with?("http") %>

<article class="catalogue-card <%= "catalogue-card--past" if past %>">
  <a href="<%= helpers.cms_page_path(page) %>" class="catalogue-card__media-link" aria-label="<%= page.title %>">
    <%= image_tag image_url, alt: page.title, class: "catalogue-card__media", loading: "lazy", decoding: "async" %>
  </a>

  <div class="catalogue-card__body">
    <div class="catalogue-card__top">
      <div class="catalogue-card__stamp">
        <span class="catalogue-card__stamp-value"><%= helpers.event_day_number(page) %></span>
        <span class="catalogue-card__stamp-label"><%= helpers.event_month_short(page) %></span>
      </div>

      <div class="catalogue-card__meta-block">
        <p class="catalogue-card__eyebrow"><%= past ? "Completed event" : "Upcoming event" %></p>
        <p class="catalogue-card__detail">
          <time datetime="<%= helpers.event_datetime(page)&.iso8601 %>"><%= helpers.event_date_label(page) %></time>
          <% unless past %>
            <span aria-hidden="true">•</span>
            <span><%= helpers.event_time_label(page) %></span>
          <% end %>
        </p>
      </div>
    </div>

    <h3 class="catalogue-card__title">
      <%= link_to page.title, helpers.cms_page_path(page), class: "catalogue-card__title-link" %>
    </h3>

    <p class="catalogue-card__summary"><%= summary %></p>

    <div class="catalogue-card__footer">
      <p class="catalogue-card__supporting"><%= location %></p>
      <%= link_to label, url, class: "catalogue-card__button", target: (external ? "_blank" : nil), rel: (external ? "noopener" : nil) %>
    </div>
  </div>
</article>
